# ==============================================================================
# HR Policy Assistant - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================


# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here

# --- Jina AI ---
JINA_API_KEY=your_jina_api_key_here

# --- Qdrant Cloud Vector Store ---
# NOTE: Must include :443 port at the end of the URL
QDRANT_URL=https://<your-cluster-id>.<region>.aws.cloud.qdrant.io:443
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=hr_policy

# --- LangSmith Tracing & Evaluation ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=hr_policy_assistant
